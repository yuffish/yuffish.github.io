---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">
          {{ site.first_name }} {{ site.middle_name }}{{ site.last_name }}
        </span>
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}    
  </article>
</div>


<div class="section publications">
  <h2>Publications</h2>
    {% for paper in site.data.publications %}
      <div class="row pub-row">
        <div class="col-sm-5 pub-image">
          {% if paper.image %} 
          <a href="{{ paper.image }}" target="_blank"><img src="{{ paper.image }}"></a>
          {% endif %}
        </div>
        <div class="col-sm-7 pub-content">
          <h3 class="title">{{ paper.title }}</h3>
          <div class="authors">{{ paper.authors }}.</div>
          <div class="conference"><em>{{ paper.conference }}</em></div>
          <div class="links">
            {% if paper.page %} 
              <a href="{{ paper.page }}" target="_blank">[webpage]</a>
              {% endif %}
            {% if paper.link %} 
              <a href="{{ paper.link }}" target="_blank">[link]</a>
              {% endif %}
            {% if paper.pdf %} 
            <a href="{{ paper.pdf }}" target="_blank">[pdf]</a>
            {% endif %}
            {% if paper.code %} 
            <a href="{{ paper.code }}" target="_blank">[code]</a>
            {% endif %}
            {% if paper.poster %} 
              <a href="{{ paper.poster }}" target="_blank">[poster]</a>
              {% endif %}
            {% if paper.bibtex %} 
            <a href="{{ paper.bibtex }}" target="_blank">[bibtex]</a>
            {% endif %}
            {% if paper.notes %} 
            &nbsp; <strong> <i style="color:#e74d3c">{{ paper.notes }}</i></strong>
            {% endif %}
            {% if paper.others %} 
            {{ paper.others }}
            {% endif %}
          </div>
        </div>
    </div>
    {% endfor %}
</div>

<div class="section services">
  <h2>Services</h2>
  <ul>
    {% for service in site.data.services %}
      <li>
        {{ service }}
      </li>
    {% endfor %}
  </ul>
</div>

<div class="section teaching">
  <h2>Teaching</h2>
  <ul>
    {% for course in site.data.teaching %}
      <li>
        {{ course }}
      </li>
    {% endfor %}
  </ul>
</div>

